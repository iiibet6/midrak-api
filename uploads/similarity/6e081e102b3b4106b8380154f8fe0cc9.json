          ],
          "statement": {
            "form": null,
            "phonetic": null,
            "dialect": null,
            "audio": null
          }
        },
        "translations": [],
        "contexts": [
          {
            "form": "ومضى عبد الله بن قيس يسير على الساحل ويتدسس في ثناياه ويفحص صخوره وخلجانه، ويعد حصونه ومسالحه، حتى مالت الشمس إلى المغيب"
          },
          {
            "form": "استطاع أن يفتتح جزائر أرواد وقبرص ورودس وغيرها، وبث فيها المسالح وجعلها مناظر للعرب"
          },
          {
            "form": "وكان من مظاهر ذلك ما يشيدونه من المدن والقرى والقصور والقلاع، التي كانت تُعرف بالمسالح، والتي كانت تكوِّن خط دفاع في أطراف حوران"
          }
        ],
        "domainIds": [
          "320"
