      {
        "definition": {
          "statement": {
            "form": null
          },
          "textRepresentations": [
            {
              "form": "ثَغْر، مَوْضع يَقِف فيه الجُنْد المُسَلَّح للِْمُراقَبِة وَالمُحافَظَة"
            }
          ]
        },
        "translations": [],
        "contexts": [],
        "domainIds": [
          null
        ],
        "examples": [
          {
            "form": "أما المَسالِحُ التي كانت بإزاء الجزيرة العربية فهي : ثغر الهند وفيه أكثر من خمس مَسالِحٍ، أشهرها الأبلة. ۲ - مَسالِحُ الحيرة ومنها خندق سابور، وفيها عدد كبير من المَسالِحِ، ورابطة كثيفة من الخيل في ألف رجل. تشرف على المَسالِحِ",
            "exampleType": "other",
            "source": "بحوث المؤتمر الجغرافي الإسلامي الأول، جامعة الإمام محمد بن سعود الإسلامية، مركز البحوث، المجلد 4، ص: 89."
          },
          {
            "form": "يخرج الدجال فيتوجه قبله رجل من المؤمنين فتلقاه المَسالِحُ مسالح الدجال",
            "exampleType": "hadith",
            "source": "الموسوعة الكبرى لأطراف الحديث النبوي الشريف، محمد السعيد بن بسيوني زغلول، 1-50 ج50 - ص: 142."
          },
          {
            "form": "المبحث الثالث: في أن الفاروق أول من وضع المَسالِحَ الحربية على الحدود",
            "exampleType": "other",
            "source": "أوليات الفاروق السياسية، غالب عبد الكافي قرشي، ص: 283"
          }
        ],
