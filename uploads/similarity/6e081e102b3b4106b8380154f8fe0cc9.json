        "definition": {
          "textRepresentations": [
            {
              "form": "ثَغْرٌ، يَقِفُ فِيهِ الْجُنْدُ بِالسِّلَاحِ لِلْمُراقَبَةِ وَالْمُحافَظَةِ.",
