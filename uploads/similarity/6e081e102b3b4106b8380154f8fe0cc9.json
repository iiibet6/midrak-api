          "textRepresentations": [
            {
              "form": " مُرَفَّهُ العَيْشِ"
            }
          ]
        },
        "translations": [],
        "contexts": [],
        "domainIds": [
          null
        ],
        "examples": [
          {
            "form": "إلا أن الرجلَ ابتلي فيهما ابتلاء حتى غفل عن راحة العقل التـَرِفِ",
            "exampleType": "other",
            "source": "صحيفة الاقتصادية، على الرابط الآتي: https://www.aleqt.com/2009/05/01/article_11686.html"
          },
          {
            "form": "اعذريني،  إنْ متُّ،  لفِّيني بسنديانٍ تَرِفِ.  ادْفنيني،  أو لا تدفنيني",
            "exampleType": "poem",
            "source": "موقع العربي الجديد، على الرابط الآتي: https://diffah.alaraby.co.uk/diffah/literature/2017/5/15/%D9%82%D9%84%D9%82-%D8%B9%D9%84%D9%89-%D8%B8%D9%84-%D8%A7%D9%84%D8%BA%D8%B1%D9%8A%D8%A8%D8%A9"
          },
          {
            "form": "وكان رَبع القامة إلى القصر ما هو، دري اللون، صغير العينين، أحور حسن الوجه واللحية أصهبها، أفضت الخلافة إليه، وهو صغير، غِرّ، تَرِفٌ، لم يعانِ الأمور",
            "exampleType": "other",
            "source": "المكتبة الشاملة، على الرابط الآتي: https://shamela.ws/book/132443/84"
          }
        ],
        "subSenses": [],
        "relations": [
