          "textRepresentations": [
            {
              "form": " مُرَفَّهٌ في عَيْشِهِ"
            }
          ]
        },
        "translations": [
          {
            "language": "en"
          }
        ],
        "contexts": [
          {
            "form": " فما أحلى الحنينَ وَما أشْدَى ففي النيل أرواحٌ ترِفُّ خوافقٌ تقاسمُكِ التاريخَ والدينَ والوُدّا"
          },
          {
            "form": "فلا وَسَنا ولكنْ يقظةٌ أبد، ولا موت يحدّ حدود ذاك الحاضر الترِفِ"
          },
          {
            "form": "جيكورُ مسِّي جبيني فهو ملتهبُ*مسِّيه بالسَّعَفِ والسُّنْبل الترِفِ"
          },
          {
            "form": "وكان مولعًا بشم الرائحة الطيبة من المسك والعود والبخور، وكان ترِفًا في مأكله ومشربه وملبسه"
          }
        ],
        "domainIds": [
