            "audio": null
          }
        },
        "translations": [],
        "contexts": [
          {
            "form": "وداخِلُ الحَمَّامِ مَقاصِيرُ بِأَبْوابٍ، وفِي المَسْلَحِ أَيْضًا مَقاصِيرُ لِأَرْبابِ التَّخَصُّصِ حَتَّى لا يَخْتَلِطُوا بالعَوامِّ وَلَا يَظْهَرُوا عَلى عَوْراتِهِمْ ",
            "showInResults": false
          },
          {
            "form": " وهَذا المَسْلَحُ بِمَقاصِيرِهِ حَسَنُ القِسْمَةِ مَلِيحُ البِنْيَةِ وفِي وَسَطِهِ بِرْكَةٌ مُرَخَّمَةٌ",
            "showInResults": false
          }
        ],
        "domainIds": [
